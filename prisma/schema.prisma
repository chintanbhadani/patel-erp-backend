generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLANT_ADMIN
  SHIFT_SUPERVISOR
  QC_INSPECTOR
  SALES_REP
}

enum Shift {
  DAY
  NIGHT
}

enum Machine {
  A
  B
  C
  D
}

enum RollStatus {
  PENDING
  QC_PASSED
  QC_FAILED
  SHIPPED
}

model User {
  id               String              @id @default(uuid())
  username         String              @unique
  password         String
  role             Role
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  jobs             ProductionJob[]
  clients          Client[]
  outlookConnection OutlookConnection?
  activities       ActivityLog[]
}

model ProductionJob {
  id               String       @id @default(uuid())
  machine          Machine
  shift            Shift
  targetDimensions String
  priority         Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  supervisorId     String?
  supervisor       User?        @relation(fields: [supervisorId], references: [id])
  rolls            RollEntry[]
  qcLogs           QCLog[]
}

model RollEntry {
  id             String        @id @default(uuid())
  barcode        String        @unique
  grossWeight    Float
  coreTareWeight Float         @default(1.0)
  netWeight      Float
  status         RollStatus    @default(PENDING)
  jobId          String
  job            ProductionJob @relation(fields: [jobId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model QCLog {
  id              String        @id @default(uuid())
  tensileStrength Float
  splitTest       Float
  elongation      Float
  gpm             Float         // Grams Per Meter
  jobId           String
  job             ProductionJob @relation(fields: [jobId], references: [id])
  createdAt       DateTime      @default(now())
}

enum Status {
  Active
  Inactive
}

model Supplier {
  id       String    @id @default(uuid())
  name     String
  contact  String?
  email    String?
  products Product[]
  invoices Invoice[]
  payments Payment[]
  grns     Grn[]
}

model Category {
  id         String      @id @default(uuid())
  name       String
  products   Product[]
  skuMasters SkuMaster[]
}

model Unit {
  id       String    @id @default(uuid())
  name     String
  products Product[]
}

model Product {
  id            String        @id @default(uuid())
  sku           String        @unique
  name          String
  quantity      Int           @default(0)
  cost_price    Decimal       @db.Decimal(10, 2)
  selling_price Decimal       @db.Decimal(10, 2)
  min_stock     Int           @default(0)
  location      String?
  status        Status        @default(Active)
  categoryId    String?
  category      Category?     @relation(fields: [categoryId], references: [id])
  supplierId    String?
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])
  invoiceDate   DateTime?
  unitId        String?
  unit          Unit?         @relation(fields: [unitId], references: [id])
  invoiceItems  InvoiceItem[]
  stockLedgers  StockLedger[]
  grnItems      GrnItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum InvoiceType {
  PURCHASE
  SALES
}

enum PaymentType {
  CASH
  BANK
}

enum GrnStatus {
  DRAFT
  PENDING_INSPECTION
  ACCEPTED
  REJECTED
  PARTIALLY_ACCEPTED
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  type          InvoiceType
  date          DateTime      @default(now())
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentType   PaymentType   @default(CASH)
  cashAmount    Decimal       @default(0) @db.Decimal(10, 2)
  bankAmount    Decimal       @default(0) @db.Decimal(10, 2)
  creditAmount  Decimal       @default(0) @db.Decimal(10, 2)
  grnStatus     String        @default("PENDING_GRN")
  items         InvoiceItem[]
  stockLedgers  StockLedger[]
  payments      Payment[]
  grns          Grn[]

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id         String  @id @default(uuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
}

model SkuMaster {
  id         String    @id @default(uuid())
  name       String
  sku        String    @unique
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseMaster {
  id          String   @id @default(uuid())
  description String   @unique
  createdAt   DateTime @default(now())
}

model QualityParameter {
  id             String    @id @default(uuid())
  parameter_name String
  unit           String?
  min_value      Float?
  max_value      Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  entityType  String
  entityId    String
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
}

model Client {
  id               String    @id @default(uuid())
  companyName      String
  email            String?
  phone            String?
  gstNumber        String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  assignedRepId    String?
  assignedRep      User?     @relation(fields: [assignedRepId], references: [id])
  inquiries        Inquiry[]
  invoices         Invoice[]
  payments         Payment[]
}

model Inquiry {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id])
  sizeInTons   Float
  quotedPrice  Float
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OutlookConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Inventory {
  id           String   @id @default(uuid())
  materialName String   @unique
  quantityKg   Float    @default(0)
  lastUpdated  DateTime @default(now()) @updatedAt
}

model StockLedger {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  date           DateTime // The transaction/invoice date
  type           String // 'PURCHASE', 'SALES', 'INITIAL', 'ADJUSTMENT'
  quantityChange Int
  runningBalance Int
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id            String      @id @default(uuid())
  date          DateTime    @default(now())
  paymentType   PaymentType // CASH or BANK
  direction     String      // "IN" or "OUT"
  amount        Decimal     @db.Decimal(10, 2)
  description   String?
  
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  
  supplierId    String?
  supplier      Supplier?   @relation(fields: [supplierId], references: [id])
  
  invoiceId     String?
  invoice       Invoice?    @relation(fields: [invoiceId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Grn {
  id           String    @id @default(uuid())
  grnNumber    String    @unique
  invoiceId    String
  invoice      Invoice   @relation(fields: [invoiceId], references: [id])
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  receivedDate DateTime  @default(now())
  status       GrnStatus @default(PENDING_INSPECTION)
  notes        String?
  items        GrnItem[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model GrnItem {
  id               String  @id @default(uuid())
  grnId            String
  grn              Grn     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  orderedQuantity  Int
  receivedQuantity Int
  acceptedQuantity Int
  rejectedQuantity Int     @default(0)
  unitPrice        Decimal @db.Decimal(10, 2)
  remarks          String?
}

