generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLANT_ADMIN
  SHIFT_SUPERVISOR
  QC_INSPECTOR
  SALES_REP
}

enum Shift {
  DAY
  NIGHT
}

enum Machine {
  A
  B
  C
  D
}

enum RollStatus {
  PENDING
  QC_PASSED
  QC_FAILED
  SHIPPED
}

model User {
  id                      String            @id @default(uuid())
  employeeId              String?
  username                String            @unique
  fullName                String?
  firstName               String?
  lastName                String?
  email                   String?
  contactNumber           String?
  password                String
  role                    String            @default("Admin")
  status                  String            @default("Active")
  isBlock                 Boolean           @default(false)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  jobs                    ProductionJob[]
  clients                 Client[]
  outlookConnection       OutlookConnection?
  activities              ActivityLog[]
  createdMaterialRequests MaterialRequest[] @relation("MaterialRequestCreatedUser")
  purchaseOrders          PurchaseOrder[]   @relation("PurchaseOrderUser")
  createdPurchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderCreatedUser")
}

model ProductionJob {
  id               String       @id @default(uuid())
  machine          Machine
  shift            Shift
  targetDimensions String
  priority         Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  supervisorId     String?
  supervisor       User?        @relation(fields: [supervisorId], references: [id])
  rolls            RollEntry[]
  qcLogs           QCLog[]
}

model RollEntry {
  id             String        @id @default(uuid())
  barcode        String        @unique
  grossWeight    Float
  coreTareWeight Float         @default(1.0)
  netWeight      Float
  status         RollStatus    @default(PENDING)
  jobId          String
  job            ProductionJob @relation(fields: [jobId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model QCLog {
  id              String        @id @default(uuid())
  tensileStrength Float
  splitTest       Float
  elongation      Float
  gpm             Float // Grams Per Meter
  jobId           String
  job             ProductionJob @relation(fields: [jobId], references: [id])
  createdAt       DateTime      @default(now())
}

enum Status {
  Active
  Inactive
}

model Supplier {
  id                       Int             @id @default(autoincrement())
  name                     String
  contact                  String?
  email                    String?
  supplierGroup            String?         @default("All Supplier Groups")
  country                  String?         @default("India")
  supplierType             String?         @default("Company")
  isTransporter            Boolean         @default(false)
  contactPersonName        String?
  billingCurrency          String?         @default("INR")
  priceList                String?         @default("Standard Buying")
  bankAccount              String?
  trackExchangeDifferences Boolean         @default(true)
  taxId                    String?
  vrnNo                    String?
  address                  String?
  city                     String?
  state                    String?
  postalCode               String?
  website                  String?
  payableAccount           String?         @default("Creditors - PS")
  paymentTerms             String?
  creditLimit              Float?          @default(0)
  disabled                 Boolean         @default(false)
  assignedTo               String?         @default("Julius Daffa")
  tags                     String?
  imageUrl                 String?
  attachments              Json?
  kycDocs                  Json?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @default(now()) @updatedAt
  products                 Product[]
  invoices                 Invoice[]
  payments                 Payment[]
  grns                     Grn[]
  purchaseOrders           PurchaseOrder[]
}

model Category {
  id         Int         @id @default(autoincrement())
  name       String
  disabled   Boolean     @default(false)
  products   Product[]
  skuMasters SkuMaster[]
}

model Unit {
  id       Int       @id @default(autoincrement())
  name     String
  disabled Boolean   @default(false)
  products Product[]
}

model Warehouse {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  code             String?           @unique
  address          String?
  disabled         Boolean           @default(false)
  materialRequests MaterialRequest[]
  purchaseOrders   PurchaseOrder[]
  grns             Grn[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
}

model Department {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  code             String?           @unique
  disabled         Boolean           @default(false)
  materialRequests MaterialRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
}

model PartOf {
  id        Int      @id @default(autoincrement())
  name      String
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SubPartOf {
  id        Int      @id @default(autoincrement())
  name      String
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Product {
  id                     String      @id @default(uuid())
  sku                    String      @unique
  name                   String
  quantity               Int         @default(0)
  cost_price             Decimal     @db.Decimal(10, 2)
  selling_price          Decimal     @db.Decimal(10, 2)
  min_stock              Int         @default(0)
  location               String?
  status                 Status      @default(Active)
  categoryId             Int?
  category               Category?   @relation(fields: [categoryId], references: [id])
  supplierId             Int?
  supplier               Supplier?   @relation(fields: [supplierId], references: [id])
  invoiceDate            DateTime?
  unitId                 Int?
  unit                   Unit?       @relation(fields: [unitId], references: [id])

  // ERPNext Item Master Extended Fields
  company                String?
  partOf                 String?
  subPartOf              String?
  tansadNo               String?
  withholdingTaxPurchase Float?      @default(0)
  withholdingTaxSales    Float?      @default(0)
  activityType           String?
  disabled               Boolean     @default(false)
  allowAlternativeItem   Boolean     @default(false)
  maintainStock          Boolean     @default(true)
  excisableItem          Boolean     @default(false)
  hasVariants            Boolean     @default(false)
  includeInManufacturing Boolean     @default(true)
  isFixedAsset           Boolean     @default(false)
  valuationRate          Decimal?    @default(0) @db.Decimal(10, 2)
  overDeliveryAllowance  Float?      @default(0)
  overBillingAllowance   Float?      @default(0)
  assignedTo             String?
  tags                   String?
  imageUrl               String?
  attachments            Json?
  incomeAccount          String?
  expenseAccount         String?
  hsnCode                String?
  taxRate                Float?      @default(18)

  invoiceItems           InvoiceItem[]
  stockLedgers           StockLedger[]
  grnItems               GrnItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  materialRequestItems   MaterialRequestItem[]
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

enum InvoiceType {
  PURCHASE
  SALES
}

enum PaymentType {
  CASH
  BANK
}

enum GrnStatus {
  DRAFT
  PENDING_INSPECTION
  ACCEPTED
  REJECTED
  PARTIALLY_ACCEPTED
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  type          InvoiceType
  date          DateTime      @default(now())
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentType   PaymentType   @default(CASH)
  cashAmount    Decimal       @default(0) @db.Decimal(10, 2)
  bankAmount    Decimal       @default(0) @db.Decimal(10, 2)
  creditAmount  Decimal       @default(0) @db.Decimal(10, 2)
  grnStatus     String        @default("PENDING_GRN")
  items         InvoiceItem[]
  stockLedgers  StockLedger[]
  payments      Payment[]
  grns          Grn[]

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceItem {
  id         String  @id @default(uuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
}

model SkuMaster {
  id         String    @id @default(uuid())
  name       String
  sku        String    @unique
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])
}

model Expense {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  description String
  amount      Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExpenseMaster {
  id          String   @id @default(uuid())
  description String   @unique
  createdAt   DateTime @default(now())
}

model QualityParameter {
  id             String   @id @default(uuid())
  parameter_name String
  unit           String?
  min_value      Float?
  max_value      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  entityType  String
  entityId    String
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())
}

model Client {
  id                        Int             @id @default(autoincrement())
  companyName               String
  customerType              String?         @default("Company")
  customerGroup             String?         @default("Commercial")
  territory                 String?         @default("India")
  fromLead                  String?
  fromOpportunity           String?
  fromProspect              String?
  accountManager            String?
  isAuthOtpApplied          Boolean         @default(false)
  defaultPriceList          String?         @default("Standard Selling")
  billingCurrency           String?         @default("INR")
  defaultCompanyBankAccount String?
  email                     String?
  phone                     String?
  contactPersonName         String?
  taxId                     String?
  gstNumber                 String?
  vrnNo                     String?
  taxCategory               String?         @default("Standard Rate")
  receivableAccount         String?         @default("Debtors - PS")
  paymentTerms              String?         @default("Net 30")
  creditLimit               Float?          @default(0)
  disabled                  Boolean         @default(false)
  assignedTo                String?
  tags                      String?
  address                   String?
  city                      String?
  state                     String?
  postalCode                String?
  country                   String?         @default("India")
  imageUrl                  String?
  attachments               Json?
  addresses                 Json?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  assignedRepId             String?
  assignedRep               User?           @relation(fields: [assignedRepId], references: [id])
  inquiries                 Inquiry[]
  invoices                  Invoice[]
  payments                  Payment[]
  purchaseOrders            PurchaseOrder[]
  productionOrders          ProductionOrder[]
}

model Inquiry {
  id          String   @id @default(uuid())
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id])
  sizeInTons  Float
  quotedPrice Float
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OutlookConnection {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Inventory {
  id           String   @id @default(uuid())
  materialName String   @unique
  quantityKg   Float    @default(0)
  lastUpdated  DateTime @default(now()) @updatedAt
}

model StockLedger {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  date           DateTime // The transaction/invoice date
  type           String // 'PURCHASE', 'SALES', 'INITIAL', 'ADJUSTMENT'
  quantityChange Int
  runningBalance Int
  invoiceId      String?
  invoice        Invoice? @relation(fields: [invoiceId], references: [id])
  grnId          String?
  grn            Grn?     @relation(fields: [grnId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Payment {
  id          String      @id @default(uuid())
  date        DateTime    @default(now())
  paymentType PaymentType // CASH or BANK
  direction   String // "IN" or "OUT"
  amount      Decimal     @db.Decimal(10, 2)
  description String?

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grn {
  id                String         @id @default(uuid())
  grnNumber         String         @unique
  invoiceId         String?
  invoice           Invoice?       @relation(fields: [invoiceId], references: [id])
  supplierId        Int?
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  acceptedWarehouse String?        @default("Main Store - PSL")
  warehouseId       Int?
  warehouse         Warehouse?     @relation(fields: [warehouseId], references: [id])
  receivedDate      DateTime       @default(now())
  status            GrnStatus      @default(PENDING_INSPECTION)
  notes             String?
  items             GrnItem[]
  stockLedgers      StockLedger[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model GrnItem {
  id                  String             @id @default(uuid())
  grnId               String
  grn                 Grn                @relation(fields: [grnId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id])
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  orderedQuantity     Int
  receivedQuantity    Int
  acceptedQuantity    Int
  rejectedQuantity    Int                @default(0)
  unitPrice           Decimal            @db.Decimal(10, 2)
  remarks             String?
}

model PurchaseOrder {
  id                  String              @id @default(uuid())
  poNumber            String?             @unique
  series              String?             @default("NCL-.YYYY.-.MM.-")
  status              String              @default("Draft")
  approvalStatus      String              @default("Draft")
  company             String              @default("PATEL STRAP INDUSTRIES LTD")
  supplier            String?
  supplierId          Int?
  supplierObj         Supplier?           @relation(fields: [supplierId], references: [id])
  clientId            Int?
  client              Client?             @relation(fields: [clientId], references: [id])
  materialRequestId   String?
  materialRequest     MaterialRequest?    @relation(fields: [materialRequestId], references: [id])
  transactionDate     DateTime            @default(now())
  requiredByDate      DateTime?
  paymentTerms        String?
  purchaseType        String?
  gstin               String?
  tin                 String?
  vrn                 String?
  pfiNo               String?
  user                String?
  userId              String?
  userObj             User?               @relation("PurchaseOrderUser", fields: [userId], references: [id])
  createdById         String?
  createdUser         User?               @relation("PurchaseOrderCreatedUser", fields: [createdById], references: [id])
  contact             String?
  email               String?
  setWarehouse        String?             @default("Main Store - PSL")
  warehouseId         Int?
  warehouse           Warehouse?          @relation(fields: [warehouseId], references: [id])
  currency            String?             @default("INR")
  priceList           String?             @default("Standard Buying")
  applyTaxWithholding Boolean             @default(false)
  isSubcontracted     Boolean             @default(false)
  assignedTo          String?
  tags                String?
  attachments         Json?
  createdBy           String?
  items               PurchaseOrderItem[]
  grns                Grn[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model PurchaseOrderItem {
  id                    String               @id @default(uuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemCode              String
  productId             String?
  product               Product?             @relation(fields: [productId], references: [id])
  materialRequestItemId String?
  materialRequestItem   MaterialRequestItem? @relation(fields: [materialRequestItemId], references: [id])
  requiredByDate        DateTime?
  itemGroup             String?
  quantity              Float                @default(1)
  uom                   String               @default("Pcs")
  rate                  Float                @default(0)
  receivedQty           Float                @default(0)
  amount                Float                @default(0)
  grnItems              GrnItem[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

model MaterialRequest {
  id                  String                @id @default(uuid())
  materialRequestCode String?               @unique
  series              String?               @default("PR-.YYYY.-.MM.-")
  status              String                @default("Draft")
  approvalStatus      String                @default("Draft")
  purpose             String?               @default("Purchase")
  transactionDate     DateTime              @default(now())
  requiredByDate      DateTime?
  department          String?
  departmentId        Int?
  departmentObj       Department?           @relation(fields: [departmentId], references: [id])
  requiredFor         String?
  priceList           String?               @default("Standard Buying")
  company             String                @default("PATEL STRAP INDUSTRIES LTD")
  attendBy            String?
  purchaseType        String?
  setWarehouse        String?               @default("Main Store - PSL")
  warehouseId         Int?
  warehouse           Warehouse?            @relation(fields: [warehouseId], references: [id])
  assignedTo          String?
  tags                String?
  attachments         Json?
  createdBy           String?
  createdById         String?
  createdUser         User?                 @relation("MaterialRequestCreatedUser", fields: [createdById], references: [id])
  items               MaterialRequestItem[]
  purchaseOrders      PurchaseOrder[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

model MaterialRequestItem {
  id                 String              @id @default(uuid())
  materialRequestId  String
  materialRequest    MaterialRequest     @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  itemCode           String
  productId          String?
  product            Product?            @relation(fields: [productId], references: [id])
  sparePart          String?
  requiredByDate     DateTime?
  quantity           Float               @default(1)
  uom                String              @default("Pcs")
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ProductionOrder {
  id                      String                  @id @default(uuid())
  orderNumber             String?                 @unique
  series                  String?                 @default("PSPL/PO-.YYYY.-.MM.-")
  orderSheetDate          DateTime                @default(now())
  customerStatus          String?                 @default("OLD")
  state                   String?
  city                    String?
  customerType            String?                 @default("USER")
  apxDispatchDays         String?
  creditDays              String?
  piNo                    String?
  customerName            String
  clientId                Int?
  client                  Client?                 @relation(fields: [clientId], references: [id])
  billingAddress          String?
  email                   String?
  contactNo               String?
  contactPerson           String?
  consigneeAddress        String?
  deliveryTerms           String?
  poNumber                String?
  poDate                  DateTime?
  customerGstin           String?
  packingDetails          String?
  stackingDetails         String?
  remarks                 String?
  marketing               String?
  ndAmount                Float?
  odAmount                Float?
  odDays                  Int?
  paymentStatus           String?                 @default("Pending")
  production              String?
  logistic                String?
  account                 String?
  managingDirector        String?
  authorisedSign          String?
  transporterName         String?
  transportGstin          String?
  lrNo                    String?
  lrDate                  DateTime?
  vehicleNo               String?
  driverName              String?
  mobileNo                String?
  insurance               String?                 @default("YES")
  waybillPartB            String?                 @default("YES")
  dispatchDate            DateTime?
  status                  String                  @default("Draft")
  assignedTo              String?
  tags                    String?
  attachments             Json?
  createdAt               DateTime                @default(now())
  createdBy               String?
  updatedAt               DateTime                @updatedAt
  items                   ProductionOrderItem[]
}

model ProductionOrderItem {
  id                      String          @id @default(uuid())
  productionOrderId       String
  productionOrder         ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  srNo                    Int?
  sizeLength              String?
  colour                  String?
  coreSize                String?
  surface                 String?
  noOfArticles            Int?
  netWtArticles           Float?
  mtrsPerArticles         Float?
  totalWt                 Float?
  quantity                Float?
  unit                    String?         @default("NOS")
  ratePerUnit             Float?
  breakingLoad            String?
  palletQuantity          String?
  gstPercent              Float?          @default(18.0)
  freightTerms            String?         @default("PAID")
  totalAmount             Float?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}
